{
  "name": "peetmail",
  "version": "0.1.0",
  "description": "Fast, keyboard-first mail and calendar for Windows",
  "author": "Peet Software",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri",
    "test": "pnpm test:unit && pnpm test:rust",
    "test:unit": "vitest run",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --locked -- -D warnings",
    "test:e2e": "playwright test",
    "build:debug": "tauri build --debug --no-bundle",
    "verify": "pnpm version:check && pnpm check && pnpm test:unit && pnpm lint:rust && pnpm test:rust && pnpm test:e2e",
    "drive": "node tests/harness/drive.ts",
    "fake-graph": "node tests/harness/fake-graph.ts --verbose",
    "bench:open": "node tests/bench/open-large.ts",
    "icons": "node scripts/icons.ts",
    "version:check": "node scripts/version.ts check",
    "version:set": "node scripts/version.ts set"
  },
  "license": "MIT",
  "packageManager": "pnpm@11.5.3",
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@lucide/svelte": "^1.61.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "dompurify": "^3.4.17",
    "marked": "^18.1.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.6.5",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.0.5"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
