{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PeetMail",
  "version": "../package.json",
  "identifier": "com.peetsoftware.peetmail",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "img-src": "'self' data:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "frame-src": "'self' about:",
        "connect-src": "ipc: http://ipc.localhost"
      },
      "devCsp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "img-src": "'self' data:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "frame-src": "'self' about:",
        "connect-src": "ipc: http://ipc.localhost ws://localhost:1420 ws://127.0.0.1:1420",
        "script-src": "'self' 'unsafe-inline'"
      },
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Peet Software",
    "copyright": "Copyright (c) 2026 Peet Software",
    "license": "MIT",
    "category": "Productivity",
    "shortDescription": "Keyboard-first mail and calendar",
    "longDescription": "PeetMail is a fast, keyboard-first mail and calendar client for Microsoft 365, Outlook.com and Gmail.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
